# ============================================================
# FinovaTech — Variables de entorno
# ============================================================
# Copia este archivo como ".env" y completa los datos de tu MySQL.
# (En Windows: copia .env.example a .env)


# Servidor MySQL
DB_HOST=localhost
DB_PORT=3306

# Usuario y contraseña de MySQL
DB_USER=root
DB_PASSWORD=

# Nombre de la base de datos del proyecto
DB_NAME=finovatech

# Clave para cifrar las sesiones (OBLIGATORIA y secreta).
# Genera una propia con:  python -c "import secrets; print(secrets.token_hex(32))"
# Si falta, la aplicación NO arranca (protección de seguridad).
SECRET_KEY=

# ------------------------------------------------------------
# Correo saliente (recuperación de contraseña, opcional)
# ------------------------------------------------------------
# Sin MAIL_SERVER el enlace de recuperación se escribe en el log
# del servidor (modo local), nunca en la respuesta HTTP.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_MINUTES=30